{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Battery simulator",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/simulators/fake_battery.py",
      "cwd": "${workspaceFolder}/.demo",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    },
    {
      "name": "Utility simulator + dashboard",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/simulators/fake_grid_server.py",
      "cwd": "${workspaceFolder}/.demo",
      "env": {"SIM_DER_POLL_RATE": "30"},
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    },
    {
      "name": "Gateway",
      "type": "debugpy",
      "request": "launch",
      "module": "capstone",
      "cwd": "${workspaceFolder}/.demo",
      "env": {"IEEE_SERVER_URL": "http://127.0.0.1:5001", "DER_SET_MAX_W": "1000000",
              "DER_SET_MAX_CHARGE_RATE_W": "1000000", "DER_SET_MAX_DISCHARGE_RATE_W": "1000000"},
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    }
  ],
  "compounds": [
    {
      "name": "Live demo (battery + utility + gateway)",
      "configurations": ["Battery simulator", "Utility simulator + dashboard", "Gateway"],
      "stopAll": true
    }
  ]
}
