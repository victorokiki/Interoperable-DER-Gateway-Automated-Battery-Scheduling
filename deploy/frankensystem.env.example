# Settings for the test against Invinity's own system ("Frankensystem").
# Copy this file to deploy/frankensystem.env, fill in the three values Invinity gives you,
# and load it with deploy/run_frankensystem.ps1 (see docs/FRANKENSYSTEM_TEST_DAY.md).
#
# It starts READ-ONLY: the gateway reads the battery and refuses every write to it.
# Change BMS_READ_ONLY to 0 ONLY when an Invinity engineer is beside you and has said yes.

# ---- Fill these in (ask Invinity) -------------------------------------------------
MODBUS_HOST=CHANGE_ME_BMS_IP_ADDRESS
MODBUS_PORT=502
MODBUS_UNIT_ID=255

# ---- Safety -------------------------------------------------------------------------
# 1 = look but never touch. 0 = the gateway may command the battery.
BMS_READ_ONLY=1
# Do not let the gateway start a battery it finds Off, even after read-only is switched off,
# until Invinity agrees.
BMS_START_FROM_OFF=0

# ---- Where the schedule comes from ----------------------------------------------------
# Our own simulated utility server on this laptop (python -m simulators.fake_grid_server).
IEEE_SERVER_URL=http://localhost:5001
ALLOW_INSECURE_TRANSPORT=1
